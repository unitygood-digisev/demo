# 環境變數範例。複製成 .env 後填入真實值；.env 不可提交。
# 不要把真實值寫在這個檔案裡。

# 大模型服務的金鑰（階段 0 只用 mock，不需要填）
LLM_API_KEY=

# 系統 2 財務輸出要存的公司資料夾（不得是專案倉庫內的路徑）
FINANCE_OUT_DIR=

# Google 試算表同步（階段 4b，設定步驟見 docs/handover/google_sheets.md）
# 試算表網址中 /d/ 和 /edit 之間那一串
MGMT_SHEET_ID=
# 服務帳號金鑰檔（.json）的完整路徑；金鑰檔不可放進專案資料夾或提交
GOOGLE_APPLICATION_CREDENTIALS=

# 每日情報郵件（階段 1b，設定步驟見 docs/handover/daily_push.md）
# 寄件帳號（必須是公司信箱）
MAIL_FROM=
# 寄件帳號的「應用程式密碼」（16 碼，不是登入密碼）
MAIL_APP_PASSWORD=
# 收件人白名單，多人用逗號分隔，只能是公司信箱
MAIL_TO=
